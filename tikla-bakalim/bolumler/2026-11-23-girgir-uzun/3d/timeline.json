{"END": 177.85, "S": [{"id": "hookAir#0", "text": "Karadenizli balıkçılar koca bir hamsi sürüsünü tek ağla yakalıyor.", "s": 0.25, "e": 3.873, "words": [{"w": "Karadenizli", "s": 0.25, "e": 0.87}, {"w": "balıkçılar", "s": 0.87, "e": 1.442}, {"w": "koca", "s": 1.442, "e": 1.728}, {"w": "bir", "s": 1.728, "e": 1.966}, {"w": "hamsi", "s": 1.966, "e": 2.3}, {"w": "sürüsünü", "s": 2.3, "e": 2.776}, {"w": "tek", "s": 2.776, "e": 3.015}, {"w": "ağla", "s": 3.015, "e": 3.301}, {"w": "yakalıyor.", "s": 3.301, "e": 3.873}]}, {"id": "hookUnder#1", "text": "Ama asıl sır, ağın altında.", "s": 4.053, "e": 6.221, "words": [{"w": "Ama", "s": 4.053, "e": 4.381}, {"w": "asıl", "s": 4.381, "e": 4.775}, {"w": "sır,", "s": 4.775, "e": 5.17}, {"w": "ağın", "s": 5.17, "e": 5.564}, {"w": "altında.", "s": 5.564, "e": 6.221}]}, {"id": "harbor#2", "text": "Baştan anlatayım.", "s": 6.401, "e": 7.601, "words": [{"w": "Baştan", "s": 6.401, "e": 6.881}, {"w": "anlatayım.", "s": 6.881, "e": 7.601}]}, {"id": "cta#3", "text": "Böyle merak edilen şeyleri basitçe anlatıyoruz, abone olmayı unutma.", "s": 7.781, "e": 11.404, "words": [{"w": "Böyle", "s": 7.781, "e": 8.106}, {"w": "merak", "s": 8.106, "e": 8.431}, {"w": "edilen", "s": 8.431, "e": 8.803}, {"w": "şeyleri", "s": 8.803, "e": 9.221}, {"w": "basitçe", "s": 9.221, "e": 9.639}, {"w": "anlatıyoruz,", "s": 9.639, "e": 10.289}, {"w": "abone", "s": 10.289, "e": 10.614}, {"w": "olmayı", "s": 10.614, "e": 10.986}, {"w": "unutma.", "s": 10.986, "e": 11.404}]}, {"id": "shipHero#4", "text": "Bu yöntemin adı gırgır.", "s": 11.584, "e": 13.388, "words": [{"w": "Bu", "s": 11.584, "e": 11.841}, {"w": "yöntemin", "s": 11.841, "e": 12.486}, {"w": "adı", "s": 12.486, "e": 12.808}, {"w": "gırgır.", "s": 12.808, "e": 13.388}]}, {"id": "crew#5", "text": "Bir gırgır teknesinde otuza yakın kişi birlikte çalışabiliyor.", "s": 13.568, "e": 16.827, "words": [{"w": "Bir", "s": 13.568, "e": 13.798}, {"w": "gırgır", "s": 13.798, "e": 14.165}, {"w": "teknesinde", "s": 14.165, "e": 14.716}, {"w": "otuza", "s": 14.716, "e": 15.037}, {"w": "yakın", "s": 15.037, "e": 15.358}, {"w": "kişi", "s": 15.358, "e": 15.634}, {"w": "birlikte", "s": 15.634, "e": 16.093}, {"w": "çalışabiliyor.", "s": 16.093, "e": 16.827}]}, {"id": "crew#6", "text": "Peki bu kadar insan neden gerekiyor?", "s": 17.007, "e": 19.539, "words": [{"w": "Peki", "s": 17.007, "e": 17.361}, {"w": "bu", "s": 17.361, "e": 17.596}, {"w": "kadar", "s": 17.596, "e": 18.008}, {"w": "insan", "s": 18.008, "e": 18.42}, {"w": "neden", "s": 18.42, "e": 18.833}, {"w": "gerekiyor?", "s": 18.833, "e": 19.539}]}, {"id": "crew#7", "text": "Çünkü bu iş, saniyelerin önemli olduğu bir takım oyunu.", "s": 19.719, "e": 23.342, "words": [{"w": "Çünkü", "s": 19.719, "e": 20.109}, {"w": "bu", "s": 20.109, "e": 20.332}, {"w": "iş,", "s": 20.332, "e": 20.611}, {"w": "saniyelerin", "s": 20.611, "e": 21.335}, {"w": "önemli", "s": 21.335, "e": 21.781}, {"w": "olduğu", "s": 21.781, "e": 22.227}, {"w": "bir", "s": 22.227, "e": 22.506}, {"w": "takım", "s": 22.506, "e": 22.896}, {"w": "oyunu.", "s": 22.896, "e": 23.342}]}, {"id": "season#8", "text": "Peki ne zaman denize çıkılıyor?", "s": 23.522, "e": 25.69, "words": [{"w": "Peki", "s": 23.522, "e": 23.873}, {"w": "ne", "s": 23.873, "e": 24.108}, {"w": "zaman", "s": 24.108, "e": 24.518}, {"w": "denize", "s": 24.518, "e": 24.987}, {"w": "çıkılıyor?", "s": 24.987, "e": 25.69}]}, {"id": "season#9", "text": "Hamsi sezonu sonbaharda açılıyor ve en bereketli günleri kışa denk geliyor.", "s": 25.87, "e": 30.22, "words": [{"w": "Hamsi", "s": 25.87, "e": 26.22}, {"w": "sezonu", "s": 26.22, "e": 26.62}, {"w": "sonbaharda", "s": 26.62, "e": 27.22}, {"w": "açılıyor", "s": 27.22, "e": 27.72}, {"w": "ve", "s": 27.72, "e": 27.92}, {"w": "en", "s": 27.92, "e": 28.12}, {"w": "bereketli", "s": 28.12, "e": 28.67}, {"w": "günleri", "s": 28.67, "e": 29.12}, {"w": "kışa", "s": 29.12, "e": 29.42}, {"w": "denk", "s": 29.42, "e": 29.72}, {"w": "geliyor.", "s": 29.72, "e": 30.22}]}, {"id": "clock#10", "text": "Karadeniz'de gırgırla hamsi avı öğleden sonra üçten sabah dokuza kadar yapılıyor.", "s": 30.4, "e": 34.75, "words": [{"w": "Karadeniz'de", "s": 30.4, "e": 31.055}, {"w": "gırgırla", "s": 31.055, "e": 31.523}, {"w": "hamsi", "s": 31.523, "e": 31.85}, {"w": "avı", "s": 31.85, "e": 32.084}, {"w": "öğleden", "s": 32.084, "e": 32.505}, {"w": "sonra", "s": 32.505, "e": 32.832}, {"w": "üçten", "s": 32.832, "e": 33.16}, {"w": "sabah", "s": 33.16, "e": 33.487}, {"w": "dokuza", "s": 33.487, "e": 33.861}, {"w": "kadar", "s": 33.861, "e": 34.189}, {"w": "yapılıyor.", "s": 34.189, "e": 34.75}]}, {"id": "harborN#11", "text": "Bu yüzden tekneler çoğu zaman akşamüstü limandan çıkıyor ve gece boyunca sürünün peşinde.", "s": 34.93, "e": 40.007, "words": [{"w": "Bu", "s": 34.93, "e": 35.127}, {"w": "yüzden", "s": 35.127, "e": 35.522}, {"w": "tekneler", "s": 35.522, "e": 36.014}, {"w": "çoğu", "s": 36.014, "e": 36.31}, {"w": "zaman", "s": 36.31, "e": 36.655}, {"w": "akşamüstü", "s": 36.655, "e": 37.198}, {"w": "limandan", "s": 37.198, "e": 37.69}, {"w": "çıkıyor", "s": 37.69, "e": 38.134}, {"w": "ve", "s": 38.134, "e": 38.331}, {"w": "gece", "s": 38.331, "e": 38.627}, {"w": "boyunca", "s": 38.627, "e": 39.071}, {"w": "sürünün", "s": 39.071, "e": 39.514}, {"w": "peşinde.", "s": 39.514, "e": 40.007}]}, {"id": "dawn#12", "text": "Şanslı bir gecenin sonunda sabah limana hamsiyle dönüyorlar.", "s": 40.187, "e": 43.446, "words": [{"w": "Şanslı", "s": 40.187, "e": 40.565}, {"w": "bir", "s": 40.565, "e": 40.801}, {"w": "gecenin", "s": 40.801, "e": 41.226}, {"w": "sonunda", "s": 41.226, "e": 41.652}, {"w": "sabah", "s": 41.652, "e": 41.982}, {"w": "limana", "s": 41.982, "e": 42.36}, {"w": "hamsiyle", "s": 42.36, "e": 42.832}, {"w": "dönüyorlar.", "s": 42.832, "e": 43.446}]}, {"id": "school#13", "text": "Peki hamsi neden hep sürü halinde yüzüyor?", "s": 43.626, "e": 46.522, "words": [{"w": "Peki", "s": 43.626, "e": 43.974}, {"w": "hamsi", "s": 43.974, "e": 44.379}, {"w": "neden", "s": 44.379, "e": 44.785}, {"w": "hep", "s": 44.785, "e": 45.074}, {"w": "sürü", "s": 45.074, "e": 45.422}, {"w": "halinde", "s": 45.422, "e": 45.943}, {"w": "yüzüyor?", "s": 45.943, "e": 46.522}]}, {"id": "school#14", "text": "Çünkü sürü, küçük bir balık için en güvenli yer.", "s": 46.702, "e": 50.325, "words": [{"w": "Çünkü", "s": 46.702, "e": 47.139}, {"w": "sürü,", "s": 47.139, "e": 47.576}, {"w": "küçük", "s": 47.576, "e": 48.013}, {"w": "bir", "s": 48.013, "e": 48.326}, {"w": "balık", "s": 48.326, "e": 48.763}, {"w": "için", "s": 48.763, "e": 49.138}, {"w": "en", "s": 49.138, "e": 49.388}, {"w": "güvenli", "s": 49.388, "e": 49.95}, {"w": "yer.", "s": 49.95, "e": 50.325}]}, {"id": "predator#15", "text": "Bir yırtıcı yaklaştığında binlerce hamsi bir anda tek bir şekle dönüşüyor ve saldırganın gözünü şaşırtıyor.", "s": 50.505, "e": 56.309, "words": [{"w": "Bir", "s": 50.505, "e": 50.741}, {"w": "yırtıcı", "s": 50.741, "e": 51.165}, {"w": "yaklaştığında", "s": 51.165, "e": 51.873}, {"w": "binlerce", "s": 51.873, "e": 52.345}, {"w": "hamsi", "s": 52.345, "e": 52.675}, {"w": "bir", "s": 52.675, "e": 52.911}, {"w": "anda", "s": 52.911, "e": 53.194}, {"w": "tek", "s": 53.194, "e": 53.43}, {"w": "bir", "s": 53.43, "e": 53.666}, {"w": "şekle", "s": 53.666, "e": 53.997}, {"w": "dönüşüyor", "s": 53.997, "e": 54.516}, {"w": "ve", "s": 54.516, "e": 54.705}, {"w": "saldırganın", "s": 54.705, "e": 55.318}, {"w": "gözünü", "s": 55.318, "e": 55.696}, {"w": "şaşırtıyor.", "s": 55.696, "e": 56.309}]}, {"id": "peloton#16", "text": "Üstelik sürü halinde yüzmek, tıpkı bisikletçilerin arka arkaya dizilmesi gibi, daha az enerji harcatıyor.", "s": 56.489, "e": 61.93, "words": [{"w": "Üstelik", "s": 56.489, "e": 56.897}, {"w": "sürü", "s": 56.897, "e": 57.169}, {"w": "halinde", "s": 57.169, "e": 57.577}, {"w": "yüzmek,", "s": 57.577, "e": 57.985}, {"w": "tıpkı", "s": 57.985, "e": 58.303}, {"w": "bisikletçilerin", "s": 58.303, "e": 59.074}, {"w": "arka", "s": 59.074, "e": 59.346}, {"w": "arkaya", "s": 59.346, "e": 59.708}, {"w": "dizilmesi", "s": 59.708, "e": 60.207}, {"w": "gibi,", "s": 60.207, "e": 60.524}, {"w": "daha", "s": 60.524, "e": 60.796}, {"w": "az", "s": 60.796, "e": 60.978}, {"w": "enerji", "s": 60.978, "e": 61.341}, {"w": "harcatıyor.", "s": 61.341, "e": 61.93}]}, {"id": "feed#17", "text": "Yiyeceği bulmak da kalabalıkla daha kolay.", "s": 62.11, "e": 64.642, "words": [{"w": "Yiyeceği", "s": 62.11, "e": 62.627}, {"w": "bulmak", "s": 62.627, "e": 63.04}, {"w": "da", "s": 63.04, "e": 63.247}, {"w": "kalabalıkla", "s": 63.247, "e": 63.918}, {"w": "daha", "s": 63.918, "e": 64.228}, {"w": "kolay.", "s": 64.228, "e": 64.642}]}, {"id": "search#18", "text": "Tekne denize açılıyor ve önce sürüyü arıyor.", "s": 64.822, "e": 67.717, "words": [{"w": "Tekne", "s": 64.822, "e": 65.212}, {"w": "denize", "s": 65.212, "e": 65.657}, {"w": "açılıyor", "s": 65.657, "e": 66.214}, {"w": "ve", "s": 66.214, "e": 66.437}, {"w": "önce", "s": 66.437, "e": 66.771}, {"w": "sürüyü", "s": 66.771, "e": 67.216}, {"w": "arıyor.", "s": 67.216, "e": 67.717}]}, {"id": "sonar#19", "text": "Bunun için sonar kullanılıyor.", "s": 67.897, "e": 69.702, "words": [{"w": "Bunun", "s": 67.897, "e": 68.258}, {"w": "için", "s": 68.258, "e": 68.568}, {"w": "sonar", "s": 68.568, "e": 68.928}, {"w": "kullanılıyor.", "s": 68.928, "e": 69.702}]}, {"id": "sonar#20", "text": "Ses dalgası suya iniyor, sürüye çarpıp geri dönüyor.", "s": 69.882, "e": 73.141, "words": [{"w": "Ses", "s": 69.882, "e": 70.149}, {"w": "dalgası", "s": 70.149, "e": 70.63}, {"w": "suya", "s": 70.63, "e": 70.95}, {"w": "iniyor,", "s": 70.95, "e": 71.431}, {"w": "sürüye", "s": 71.431, "e": 71.859}, {"w": "çarpıp", "s": 71.859, "e": 72.286}, {"w": "geri", "s": 72.286, "e": 72.607}, {"w": "dönüyor.", "s": 72.607, "e": 73.141}]}, {"id": "sonarDepth#21", "text": "Yankının ne kadar sürede geri döndüğü, sürünün kaç metre derinde olduğunu söylüyor.", "s": 73.321, "e": 78.035, "words": [{"w": "Yankının", "s": 73.321, "e": 73.812}, {"w": "ne", "s": 73.812, "e": 74.008}, {"w": "kadar", "s": 74.008, "e": 74.352}, {"w": "sürede", "s": 74.352, "e": 74.745}, {"w": "geri", "s": 74.745, "e": 75.039}, {"w": "döndüğü,", "s": 75.039, "e": 75.53}, {"w": "sürünün", "s": 75.53, "e": 75.972}, {"w": "kaç", "s": 75.972, "e": 76.218}, {"w": "metre", "s": 76.218, "e": 76.562}, {"w": "derinde", "s": 76.562, "e": 77.003}, {"w": "olduğunu", "s": 77.003, "e": 77.494}, {"w": "söylüyor.", "s": 77.494, "e": 78.035}]}, {"id": "bladder#22", "text": "Balıkların içindeki küçük hava kesesi sesi güçlü yansıtıyor.", "s": 78.215, "e": 81.474, "words": [{"w": "Balıkların", "s": 78.215, "e": 78.781}, {"w": "içindeki", "s": 78.781, "e": 79.254}, {"w": "küçük", "s": 79.254, "e": 79.584}, {"w": "hava", "s": 79.584, "e": 79.868}, {"w": "kesesi", "s": 79.868, "e": 80.246}, {"w": "sesi", "s": 80.246, "e": 80.529}, {"w": "güçlü", "s": 80.529, "e": 80.86}, {"w": "yansıtıyor.", "s": 80.86, "e": 81.474}]}, {"id": "echo#23", "text": "Ekranda koca bir balık bulutu beliriyor.", "s": 81.654, "e": 84.185, "words": [{"w": "Ekranda", "s": 81.654, "e": 82.138}, {"w": "koca", "s": 82.138, "e": 82.462}, {"w": "bir", "s": 82.462, "e": 82.731}, {"w": "balık", "s": 82.731, "e": 83.108}, {"w": "bulutu", "s": 83.108, "e": 83.539}, {"w": "beliriyor.", "s": 83.539, "e": 84.185}]}, {"id": "echo#24", "text": "Kaptan bu ekrana bakarak sürünün ne kadar büyük olduğunu görüyor.", "s": 84.365, "e": 88.352, "words": [{"w": "Kaptan", "s": 84.365, "e": 84.785}, {"w": "bu", "s": 84.785, "e": 84.995}, {"w": "ekrana", "s": 84.995, "e": 85.414}, {"w": "bakarak", "s": 85.414, "e": 85.887}, {"w": "sürünün", "s": 85.887, "e": 86.359}, {"w": "ne", "s": 86.359, "e": 86.568}, {"w": "kadar", "s": 86.568, "e": 86.936}, {"w": "büyük", "s": 86.936, "e": 87.303}, {"w": "olduğunu", "s": 87.303, "e": 87.827}, {"w": "görüyor.", "s": 87.827, "e": 88.352}]}, {"id": "echo#25", "text": "Karar artık onun.", "s": 88.532, "e": 89.973, "words": [{"w": "Karar", "s": 88.532, "e": 89.012}, {"w": "artık", "s": 89.012, "e": 89.492}, {"w": "onun.", "s": 89.492, "e": 89.973}]}, {"id": "skiff#26", "text": "Sürü bulununca küçük bir tekne denize iniyor.", "s": 90.153, "e": 93.048, "words": [{"w": "Sürü", "s": 90.153, "e": 90.481}, {"w": "bulununca", "s": 90.481, "e": 91.081}, {"w": "küçük", "s": 91.081, "e": 91.464}, {"w": "bir", "s": 91.464, "e": 91.737}, {"w": "tekne", "s": 91.737, "e": 92.119}, {"w": "denize", "s": 92.119, "e": 92.557}, {"w": "iniyor.", "s": 92.557, "e": 93.048}]}, {"id": "skiff#27", "text": "Ağın bir ucunu o tutuyor.", "s": 93.228, "e": 95.396, "words": [{"w": "Ağın", "s": 93.228, "e": 93.648}, {"w": "bir", "s": 93.648, "e": 93.998}, {"w": "ucunu", "s": 93.998, "e": 94.487}, {"w": "o", "s": 94.487, "e": 94.697}, {"w": "tutuyor.", "s": 94.697, "e": 95.396}]}, {"id": "encircle#28", "text": "Büyük tekne sürünün etrafında daire çizerek ağı bırakıyor.", "s": 95.576, "e": 98.835, "words": [{"w": "Büyük", "s": 95.576, "e": 95.917}, {"w": "tekne", "s": 95.917, "e": 96.257}, {"w": "sürünün", "s": 96.257, "e": 96.695}, {"w": "etrafında", "s": 96.695, "e": 97.23}, {"w": "daire", "s": 97.23, "e": 97.571}, {"w": "çizerek", "s": 97.571, "e": 98.009}, {"w": "ağı", "s": 98.009, "e": 98.252}, {"w": "bırakıyor.", "s": 98.252, "e": 98.835}]}, {"id": "floats#29", "text": "Ağın üstünde mantarlar var.", "s": 99.015, "e": 100.82, "words": [{"w": "Ağın", "s": 99.015, "e": 99.354}, {"w": "üstünde", "s": 99.354, "e": 99.861}, {"w": "mantarlar", "s": 99.861, "e": 100.482}, {"w": "var.", "s": 100.482, "e": 100.82}]}, {"id": "floats#30", "text": "Suyun yüzünde kalıyor.", "s": 101.0, "e": 102.441, "words": [{"w": "Suyun", "s": 101.0, "e": 101.388}, {"w": "yüzünde", "s": 101.388, "e": 101.887}, {"w": "kalıyor.", "s": 101.887, "e": 102.441}]}, {"id": "lead#31", "text": "Altında kurşunlar var.", "s": 102.621, "e": 104.062, "words": [{"w": "Altında", "s": 102.621, "e": 103.12}, {"w": "kurşunlar", "s": 103.12, "e": 103.729}, {"w": "var.", "s": 103.729, "e": 104.062}]}, {"id": "lead#32", "text": "Ağı aşağı çekiyor.", "s": 104.242, "e": 105.683, "words": [{"w": "Ağı", "s": 104.242, "e": 104.569}, {"w": "aşağı", "s": 104.569, "e": 105.028}, {"w": "çekiyor.", "s": 105.028, "e": 105.683}]}, {"id": "wall#33", "text": "Böylece denizin içinde dev bir duvar oluşuyor.", "s": 105.863, "e": 108.758, "words": [{"w": "Böylece", "s": 105.863, "e": 106.345}, {"w": "denizin", "s": 106.345, "e": 106.828}, {"w": "içinde", "s": 106.828, "e": 107.257}, {"w": "dev", "s": 107.257, "e": 107.525}, {"w": "bir", "s": 107.525, "e": 107.793}, {"w": "duvar", "s": 107.793, "e": 108.168}, {"w": "oluşuyor.", "s": 108.168, "e": 108.758}]}, {"id": "wall#34", "text": "Bu ağ yüzlerce metre uzunluğunda olabiliyor.", "s": 108.938, "e": 111.47, "words": [{"w": "Bu", "s": 108.938, "e": 109.137}, {"w": "ağ", "s": 109.137, "e": 109.335}, {"w": "yüzlerce", "s": 109.335, "e": 109.832}, {"w": "metre", "s": 109.832, "e": 110.179}, {"w": "uzunluğunda", "s": 110.179, "e": 110.825}, {"w": "olabiliyor.", "s": 110.825, "e": 111.47}]}, {"id": "kulac#35", "text": "Balıkçılar ağı metreyle değil kulaçla ölçüyor.", "s": 111.65, "e": 114.182, "words": [{"w": "Balıkçılar", "s": 111.65, "e": 112.223}, {"w": "ağı", "s": 112.223, "e": 112.462}, {"w": "metreyle", "s": 112.462, "e": 112.94}, {"w": "değil", "s": 112.94, "e": 113.274}, {"w": "kulaçla", "s": 113.274, "e": 113.704}, {"w": "ölçüyor.", "s": 113.704, "e": 114.182}]}, {"id": "kulac#36", "text": "Bir kulaç, kollarını iki yana açtığında iki elinin arası kadar.", "s": 114.362, "e": 118.348, "words": [{"w": "Bir", "s": 114.362, "e": 114.631}, {"w": "kulaç,", "s": 114.631, "e": 115.062}, {"w": "kollarını", "s": 115.062, "e": 115.655}, {"w": "iki", "s": 115.655, "e": 115.924}, {"w": "yana", "s": 115.924, "e": 116.247}, {"w": "açtığında", "s": 116.247, "e": 116.84}, {"w": "iki", "s": 116.84, "e": 117.109}, {"w": "elinin", "s": 117.109, "e": 117.54}, {"w": "arası", "s": 117.54, "e": 117.917}, {"w": "kadar.", "s": 117.917, "e": 118.348}]}, {"id": "push#37", "text": "Asıl zekice kısım şimdi geliyor.", "s": 118.528, "e": 120.696, "words": [{"w": "Asıl", "s": 118.528, "e": 118.871}, {"w": "zekice", "s": 118.871, "e": 119.327}, {"w": "kısım", "s": 119.327, "e": 119.726}, {"w": "şimdi", "s": 119.726, "e": 120.126}, {"w": "geliyor.", "s": 120.126, "e": 120.696}]}, {"id": "like#38", "text": "İşine yaradıysa bir beğen bırak.", "s": 120.876, "e": 123.045, "words": [{"w": "İşine", "s": 120.876, "e": 121.276}, {"w": "yaradıysa", "s": 121.276, "e": 121.903}, {"w": "bir", "s": 121.903, "e": 122.189}, {"w": "beğen", "s": 122.189, "e": 122.588}, {"w": "bırak.", "s": 122.588, "e": 123.045}]}, {"id": "escape#39", "text": "Ama balıklar aşağıdan kaçabilir, değil mi?", "s": 123.225, "e": 125.756, "words": [{"w": "Ama", "s": 123.225, "e": 123.483}, {"w": "balıklar", "s": 123.483, "e": 124.0}, {"w": "aşağıdan", "s": 124.0, "e": 124.516}, {"w": "kaçabilir,", "s": 124.516, "e": 125.136}, {"w": "değil", "s": 125.136, "e": 125.498}, {"w": "mi?", "s": 125.498, "e": 125.756}]}, {"id": "rings#40", "text": "İşte sır burada.", "s": 125.936, "e": 127.377, "words": [{"w": "İşte", "s": 125.936, "e": 126.369}, {"w": "sır", "s": 126.369, "e": 126.729}, {"w": "burada.", "s": 126.729, "e": 127.377}]}, {"id": "pline#41", "text": "Ağın alt kenarında halkalar var.", "s": 127.557, "e": 129.725, "words": [{"w": "Ağın", "s": 127.557, "e": 127.9}, {"w": "alt", "s": 127.9, "e": 128.185}, {"w": "kenarında", "s": 128.185, "e": 128.813}, {"w": "halkalar", "s": 128.813, "e": 129.383}, {"w": "var.", "s": 129.383, "e": 129.725}]}, {"id": "pursing#42", "text": "Halkaların içinden uzun bir halat geçiyor.", "s": 129.905, "e": 132.437, "words": [{"w": "Halkaların", "s": 129.905, "e": 130.525}, {"w": "içinden", "s": 130.525, "e": 130.991}, {"w": "uzun", "s": 130.991, "e": 131.301}, {"w": "bir", "s": 131.301, "e": 131.559}, {"w": "halat", "s": 131.559, "e": 131.921}, {"w": "geçiyor.", "s": 131.921, "e": 132.437}]}, {"id": "pursing#43", "text": "Bu halat çekilince ağın altı büzülüyor.", "s": 132.617, "e": 135.149, "words": [{"w": "Bu", "s": 132.617, "e": 132.837}, {"w": "halat", "s": 132.837, "e": 133.223}, {"w": "çekilince", "s": 133.223, "e": 133.828}, {"w": "ağın", "s": 133.828, "e": 134.158}, {"w": "altı", "s": 134.158, "e": 134.489}, {"w": "büzülüyor.", "s": 134.489, "e": 135.149}]}, {"id": "pursed#44", "text": "Tıpkı ipli bir kese gibi kapanıyor.", "s": 135.329, "e": 137.861, "words": [{"w": "Tıpkı", "s": 135.329, "e": 135.751}, {"w": "ipli", "s": 135.751, "e": 136.113}, {"w": "bir", "s": 136.113, "e": 136.414}, {"w": "kese", "s": 136.414, "e": 136.776}, {"w": "gibi", "s": 136.776, "e": 137.138}, {"w": "kapanıyor.", "s": 137.138, "e": 137.861}]}, {"id": "pursed#45", "text": "Sürü artık kaçamıyor.", "s": 138.041, "e": 139.482, "words": [{"w": "Sürü", "s": 138.041, "e": 138.387}, {"w": "artık", "s": 138.387, "e": 138.79}, {"w": "kaçamıyor.", "s": 138.79, "e": 139.482}]}, {"id": "pursedAir#46", "text": "Bu halatın adı da tam olarak bunu anlatıyor: büzme halatı.", "s": 139.662, "e": 143.648, "words": [{"w": "Bu", "s": 139.662, "e": 139.893}, {"w": "halatın", "s": 139.893, "e": 140.413}, {"w": "adı", "s": 140.413, "e": 140.702}, {"w": "da", "s": 140.702, "e": 140.933}, {"w": "tam", "s": 140.933, "e": 141.222}, {"w": "olarak", "s": 141.222, "e": 141.684}, {"w": "bunu", "s": 141.684, "e": 142.031}, {"w": "anlatıyor:", "s": 142.031, "e": 142.724}, {"w": "büzme", "s": 142.724, "e": 143.128}, {"w": "halatı.", "s": 143.128, "e": 143.648}]}, {"id": "haul#47", "text": "Sonra ağ vinçle toplanıyor ve hamsi tekneye alınıyor.", "s": 143.828, "e": 147.087, "words": [{"w": "Sonra", "s": 143.828, "e": 144.196}, {"w": "ağ", "s": 144.196, "e": 144.406}, {"w": "vinçle", "s": 144.406, "e": 144.827}, {"w": "toplanıyor", "s": 144.827, "e": 145.458}, {"w": "ve", "s": 145.458, "e": 145.668}, {"w": "hamsi", "s": 145.668, "e": 146.036}, {"w": "tekneye", "s": 146.036, "e": 146.509}, {"w": "alınıyor.", "s": 146.509, "e": 147.087}]}, {"id": "pblock#48", "text": "Ağ, vincin ucundaki hidrolik bir makaradan geçirilerek çekiliyor.", "s": 147.267, "e": 150.526, "words": [{"w": "Ağ,", "s": 147.267, "e": 147.487}, {"w": "vincin", "s": 147.487, "e": 147.84}, {"w": "ucundaki", "s": 147.84, "e": 148.28}, {"w": "hidrolik", "s": 148.28, "e": 148.721}, {"w": "bir", "s": 148.721, "e": 148.941}, {"w": "makaradan", "s": 148.941, "e": 149.425}, {"w": "geçirilerek", "s": 149.425, "e": 149.998}, {"w": "çekiliyor.", "s": 149.998, "e": 150.526}]}, {"id": "hand#49", "text": "Bu makara icat edilmeden önce koca ağı tamamen kol gücüyle toplamak gerekiyordu.", "s": 150.706, "e": 155.42, "words": [{"w": "Bu", "s": 150.706, "e": 150.909}, {"w": "makara", "s": 150.909, "e": 151.315}, {"w": "icat", "s": 151.315, "e": 151.619}, {"w": "edilmeden", "s": 151.619, "e": 152.176}, {"w": "önce", "s": 152.176, "e": 152.48}, {"w": "koca", "s": 152.48, "e": 152.784}, {"w": "ağı", "s": 152.784, "e": 153.038}, {"w": "tamamen", "s": 153.038, "e": 153.494}, {"w": "kol", "s": 153.494, "e": 153.747}, {"w": "gücüyle", "s": 153.747, "e": 154.204}, {"w": "toplamak", "s": 154.204, "e": 154.71}, {"w": "gerekiyordu.", "s": 154.71, "e": 155.42}]}, {"id": "pblock#50", "text": "Birleşmiş Milletler Gıda ve Tarım Örgütü'ne göre ağ toplamayı en çok kolaylaştıran buluş bu makara.", "s": 155.6, "e": 161.405, "words": [{"w": "Birleşmiş", "s": 155.6, "e": 156.155}, {"w": "Milletler", "s": 156.155, "e": 156.71}, {"w": "Gıda", "s": 156.71, "e": 157.013}, {"w": "ve", "s": 157.013, "e": 157.215}, {"w": "Tarım", "s": 157.215, "e": 157.568}, {"w": "Örgütü'ne", "s": 157.568, "e": 158.124}, {"w": "göre", "s": 158.124, "e": 158.427}, {"w": "ağ", "s": 158.427, "e": 158.628}, {"w": "toplamayı", "s": 158.628, "e": 159.184}, {"w": "en", "s": 159.184, "e": 159.386}, {"w": "çok", "s": 159.386, "e": 159.638}, {"w": "kolaylaştıran", "s": 159.638, "e": 160.395}, {"w": "buluş", "s": 160.395, "e": 160.748}, {"w": "bu", "s": 160.748, "e": 160.95}, {"w": "makara.", "s": 160.95, "e": 161.405}]}, {"id": "brail#51", "text": "Ağ daraldıkça hamsi büyük kepçelerle ya da pompayla güverteye alınıyor, buzlanıyor ve kasalara diziliyor.", "s": 161.585, "e": 167.025, "words": [{"w": "Ağ", "s": 161.585, "e": 161.766}, {"w": "daraldıkça", "s": 161.766, "e": 162.31}, {"w": "hamsi", "s": 162.31, "e": 162.627}, {"w": "büyük", "s": 162.627, "e": 162.945}, {"w": "kepçelerle", "s": 162.945, "e": 163.489}, {"w": "ya", "s": 163.489, "e": 163.67}, {"w": "da", "s": 163.67, "e": 163.852}, {"w": "pompayla", "s": 163.852, "e": 164.305}, {"w": "güverteye", "s": 164.305, "e": 164.804}, {"w": "alınıyor,", "s": 164.804, "e": 165.303}, {"w": "buzlanıyor", "s": 165.303, "e": 165.847}, {"w": "ve", "s": 165.847, "e": 166.028}, {"w": "kasalara", "s": 166.028, "e": 166.481}, {"w": "diziliyor.", "s": 166.481, "e": 167.025}]}, {"id": "market#52", "text": "Yani sabah tezgâhta gördüğün hamsi, gece boyunca bu yolculuğu yapmış oluyor.", "s": 167.205, "e": 171.555, "words": [{"w": "Yani", "s": 167.205, "e": 167.502}, {"w": "sabah", "s": 167.502, "e": 167.848}, {"w": "tezgâhta", "s": 167.848, "e": 168.342}, {"w": "gördüğün", "s": 168.342, "e": 168.837}, {"w": "hamsi,", "s": 168.837, "e": 169.232}, {"w": "gece", "s": 169.232, "e": 169.529}, {"w": "boyunca", "s": 169.529, "e": 169.974}, {"w": "bu", "s": 169.974, "e": 170.171}, {"w": "yolculuğu", "s": 170.171, "e": 170.715}, {"w": "yapmış", "s": 170.715, "e": 171.111}, {"w": "oluyor.", "s": 171.111, "e": 171.555}]}, {"id": "outro#53", "text": "Başka hangi avcılığı merak ediyorsun?", "s": 171.735, "e": 173.904, "words": [{"w": "Başka", "s": 171.735, "e": 172.088}, {"w": "hangi", "s": 172.088, "e": 172.441}, {"w": "avcılığı", "s": 172.441, "e": 172.946}, {"w": "merak", "s": 172.946, "e": 173.299}, {"w": "ediyorsun?", "s": 173.299, "e": 173.904}]}, {"id": "comment#54", "text": "Yorumlara yaz.", "s": 174.084, "e": 175.284, "words": [{"w": "Yorumlara", "s": 174.084, "e": 174.86}, {"w": "yaz.", "s": 174.86, "e": 175.284}]}, {"id": "sign#55", "text": "Merak ettiysen, tıkla bakalım!", "s": 175.464, "e": 177.268, "words": [{"w": "Merak", "s": 175.464, "e": 175.825}, {"w": "ettiysen,", "s": 175.825, "e": 176.392}, {"w": "tıkla", "s": 176.392, "e": 176.753}, {"w": "bakalım!", "s": 176.753, "e": 177.268}]}]}