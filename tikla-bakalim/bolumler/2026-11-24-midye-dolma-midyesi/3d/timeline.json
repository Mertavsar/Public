{"END": 90.94, "S": [{"id": "hook#0", "text": "Bu midyeler denizde bir ipe asılı büyüyor.", "s": 0.07, "e": 2.44, "words": [{"w": "Bu", "s": 0.1, "e": 0.28, "c": "white"}, {"w": "midyeler", "s": 0.28, "e": 0.725, "c": "white"}, {"w": "denizde", "s": 0.725, "e": 1.18, "c": "white"}, {"w": "bir", "s": 1.18, "e": 1.36, "c": "white"}, {"w": "ipe", "s": 1.36, "e": 1.633, "c": "white"}, {"w": "asılı", "s": 1.633, "e": 2.011, "c": "white"}, {"w": "büyüyor.", "s": 2.011, "e": 2.39, "c": "white"}]}, {"id": "nofeed#1", "text": "Ve onlara hiç kimse yem vermiyor.", "s": 2.91, "e": 4.79, "words": [{"w": "Ve", "s": 2.9, "e": 3.08, "c": "white"}, {"w": "onlara", "s": 3.08, "e": 3.52, "c": "white"}, {"w": "hiç", "s": 3.52, "e": 3.7, "c": "white"}, {"w": "kimse", "s": 3.7, "e": 3.985, "c": "white"}, {"w": "yem", "s": 3.985, "e": 4.165, "c": "white"}, {"w": "vermiyor.", "s": 4.165, "e": 4.73, "c": "white"}]}, {"id": "step#2", "text": "Midye dolmanın midyesi nereden geliyor, adım adım anlatayım.", "s": 5.54, "e": 8.77, "words": [{"w": "Midye", "s": 5.53, "e": 5.845, "c": "white"}, {"w": "dolmanın", "s": 5.845, "e": 6.215, "c": "white"}, {"w": "midyesi", "s": 6.215, "e": 6.57, "c": "white"}, {"w": "nereden", "s": 6.57, "e": 6.925, "c": "white"}, {"w": "geliyor,", "s": 6.925, "e": 7.7, "c": "white"}, {"w": "adım", "s": 7.7, "e": 8.07, "c": "white"}, {"w": "adım", "s": 8.07, "e": 8.3, "c": "white"}, {"w": "anlatayım.", "s": 8.3, "e": 8.76, "c": "white"}]}, {"id": "cta#3", "text": "Bu videoyu paylaş ve abone ol ki herkes, bu işin ne kadar emek istediğini görsün.", "s": 9.14, "e": 13.65, "words": [{"w": "Bu", "s": 9.12, "e": 9.3, "c": "white"}, {"w": "videoyu", "s": 9.3, "e": 9.832, "c": "white"}, {"w": "paylaş", "s": 9.832, "e": 10.116, "c": "white"}, {"w": "ve", "s": 10.116, "e": 10.296, "c": "white"}, {"w": "abone", "s": 10.296, "e": 10.685, "c": "white"}, {"w": "ol", "s": 10.685, "e": 10.865, "c": "white"}, {"w": "ki", "s": 10.865, "e": 11.08, "c": "white"}, {"w": "herkes,", "s": 11.08, "e": 11.463, "c": "white"}, {"w": "bu", "s": 11.463, "e": 11.725, "c": "white"}, {"w": "işin", "s": 11.725, "e": 12.103, "c": "white"}, {"w": "ne", "s": 12.103, "e": 12.283, "c": "white"}, {"w": "kadar", "s": 12.283, "e": 12.482, "c": "white"}, {"w": "emek", "s": 12.482, "e": 12.735, "c": "white"}, {"w": "istediğini", "s": 12.735, "e": 13.367, "c": "white"}, {"w": "görsün.", "s": 13.367, "e": 13.62, "c": "white"}]}, {"id": "name#4", "text": "Midye dolmalık midyenin adı kara midye.", "s": 14.26, "e": 16.5, "words": [{"w": "Midye", "s": 14.23, "e": 14.555, "c": "white"}, {"w": "dolmalık", "s": 14.555, "e": 14.98, "c": "white"}, {"w": "midyenin", "s": 14.98, "e": 15.425, "c": "white"}, {"w": "adı", "s": 15.425, "e": 15.855, "c": "white"}, {"w": "kara", "s": 15.855, "e": 16.135, "c": "white"}, {"w": "midye.", "s": 16.135, "e": 16.45, "c": "white"}]}, {"id": "live#5", "text": "Ege'de, Marmara'da ve Karadeniz'de doğal olarak yaşıyor.", "s": 16.89, "e": 20.37, "words": [{"w": "Ege'de,", "s": 16.86, "e": 17.53, "c": "white"}, {"w": "Marmara'da", "s": 17.53, "e": 18.335, "c": "white"}, {"w": "ve", "s": 18.335, "e": 18.57, "c": "white"}, {"w": "Karadeniz'de", "s": 18.57, "e": 19.325, "c": "white"}, {"w": "doğal", "s": 19.325, "e": 19.67, "c": "white"}, {"w": "olarak", "s": 19.67, "e": 20.135, "c": "white"}, {"w": "yaşıyor.", "s": 20.135, "e": 20.31, "c": "white"}]}, {"id": "two#6", "text": "Midye dolmalık midyeler hem bu doğal yataklardan toplanıyor, hem de deniz çiftliklerinde yetiştiriliyor.", "s": 20.75, "e": 26.25, "words": [{"w": "Midye", "s": 20.7, "e": 21.01, "c": "white"}, {"w": "dolmalık", "s": 21.01, "e": 21.415, "c": "white"}, {"w": "midyeler", "s": 21.415, "e": 22.04, "c": "white"}, {"w": "hem", "s": 22.04, "e": 22.3, "c": "white"}, {"w": "bu", "s": 22.3, "e": 22.48, "c": "white"}, {"w": "doğal", "s": 22.48, "e": 22.75, "c": "white"}, {"w": "yataklardan", "s": 22.75, "e": 23.35, "c": "white"}, {"w": "toplanıyor,", "s": 23.35, "e": 24.14, "c": "white"}, {"w": "he