}, {"w": "ipe", "s": 37.077, "e": 37.461, "c": "white"}, {"w": "kendiliğinden", "s": 37.461, "e": 38.6, "c": "white"}, {"w": "tutunuyor,", "s": 38.6, "e": 39.36, "c": "white"}, {"w": "bazen", "s": 39.36, "e": 39.65, "c": "white"}, {"w": "bir", "s": 39.65, "e": 39.83, "c": "white"}, {"w": "metreye", "s": 39.83, "e": 40.23, "c": "white"}, {"w": "on", "s": 40.23, "e": 40.41, "c": "white"}, {"w": "binlerce", "s": 40.41, "e": 40.81, "c": "white"}, {"w": "yavru!", "s": 40.81, "e": 41.1, "c": "white"}]}, {"id": "like#11", "text": "İşine yaradıysa beğenmeyi unutma.", "s": 41.53, "e": 43.36, "words": [{"w": "İşine", "s": 41.44, "e": 41.83, "c": "white"}, {"w": "yaradıysa", "s": 41.83, "e": 42.35, "c": "white"}, {"w": "beğenmeyi", "s": 42.35, "e": 42.87, "c": "white"}, {"w": "unutma.", "s": 42.87, "e": 43.26, "c": "white"}]}, {"id": "socks#12", "text": "Yavrular biraz büyüyünce file çoraplara dolduruluyor.", "s": 43.7, "e": 46.52, "words": [{"w": "Yavrular", "s": 43.61, "e": 44.07, "c": "white"}, {"w": "biraz", "s": 44.07, "e": 44.377, "c": "white"}, {"w": "büyüyünce", "s": 44.377, "e": 45.07, "c": "white"}, {"w": "file", "s": 45.07, "e": 45.335, "c": "white"}, {"w": "çoraplara", "s": 45.335, "e": 45.86, "c": "white"}, {"w": "dolduruluyor.", "s": 45.86, "e": 46.41, "c": "white"}]}, {"id": "longline#13", "text": "Çoraplar, şamandıralara bağlı uzun halatlardan denize sarkıtılıyor.", "s": 46.94, "e": 50.79, "words": [{"w": "Çoraplar,", "s": 46.86, "e": 47.46, "c": "white"}, {"w": "şamandıralara", "s": 47.46, "e": 48.296, "c": "white"}, {"w": "bağlı", "s": 48.296, "e": 48.542, "c": "white"}, {"w": "uzun", "s": 48.542, "e": 48.787, "c": "white"}, {"w": "halatlardan", "s": 48.787, "e": 49.278, "c": "white"}, {"w": "denize", "s": 49.278, "e": 49.646, "c": "white"}, {"w": "sarkıtılıyor.", "s": 49.646, "e": 50.26, "c": "white"}]}, {"id": "whofeeds#14", "text": "Peki onları kim besliyor?", "s": 51.19, "e": 52.66, "words": [{"w": "Peki", "s": 51.09, "e": 51.412, "c": "white"}, {"w": "onları", "s": 51.412, "e": 51.896, "c": "white"}, {"w": "kim", "s": 51.896, "e": 52.076, "c": "white"}, {"w": "besliyor?", "s": 52.076, "e": 52.54, "c": "white"}]}, {"id": "secret#15", "text": "İşte sır burada.", "s": 53.03, "e": 54.01, "words": [{"w": "İşte", "s": 52.91, "e": 53.28, "c": "white"}, {"w": "sır", "s": 53.28, "e": 53.46, "c": "white"}, {"w": "burada.", "s": 53.46, "e": 53.91, "c": "white"}]}, {"id": "filter#16", "text": "Midye denizin suyunu süzüyor ve içindeki minicik planktonla besleniyor.", "s": 54.38, "e": 58.57, "words": [{"w": "Midye", "s": 54.28, "e": 54.593, "c": "white"}, {"w": "denizin", "s": 54.593, "e": 55.062, "c": "white"}, {"w": "suyunu", "s": 55.062, "e": 55.531, "c": "white"}, {"w": "süzüyor", "s": 55.531, "e": 56.1, "c": "white"}, {"w": "ve", "s": 56.1, "e": 56.349, "c": "white"}, {"w": "içindeki", "s": 56.349, "e": 56.943, "c": "white"}, {"w": "minicik", "s": 56.943, "e": 57.389, "c": "white"}, {"w": "planktonla", "s": 57.389, "e": 57.835, "c": "white"}, {"w": "besleniyor.", "s": 57.835, "e": 58.43, "c": "white"}]}, {"id": "liters#17", "text": "Beş santimlik bir midye, bir saatte beş litre su süzebiliyor!", "s": 58.91, "e": 62.52, "words": [{"w": "Beş", "s": 58.8, "e": 58.98, "c": "yellow"}, {"w": "santimlik", "s": 58.98, "e": 59.385, "c": "white"}, {"w": "bir", "s": 59.385, "e": 59.565, "c": "white"}, {"w": "midye,", "s": 59.565, "e": 59.83, "c": "white"}, {"w": "bir", "s": 59.83, "e": 60.115, "c": "white"}, {"w": "saatte", "s": 60.115, "e": 60.755, "c": "white"}, {"w": "beş", "s": 60.755, "e": 60.993, "c": "yellow"}, {"w": "litre", "s": 60.993, "e": 61.34, "c": "white"}, {"w": "su", "s": 61.34, "e": 61.52, "c": "white"}, {"w": "süzebiliyor!", "s": 61.52, "e": 62.38, "c": "white"}]}, {"id": "seafeeds#18", "text": "Yani denizin kendisi onları besliyor.", "s": 62.87, "e": 64.91, "words": [{"w": "Yani", "s": 62.76, "e": 63.062, "c": "white"}, {"w": "denizin", "s": 63.062, "e": 63.515, "c": "white"}, {"w": "kendisi", "s": 63.515, "e": 63.