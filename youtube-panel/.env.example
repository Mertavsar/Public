# Bu dosyayı .env adıyla kopyala ve doldur. .env git'e girmez.

# Ürün adı — sayfalarda ve sekme başlığında görünür.
APP_NAME=Kanalist

# Panelin açıldığı adres. Google Cloud'daki "Yetkili yönlendirme URI'si"
# bunun sonuna /oauth/callback eklenmiş hali olmalı.
#   Yerelde:  http://localhost:8000      -> http://localhost:8000/oauth/callback
#   Sunucuda: https://alanadin.com       -> https://alanadin.com/oauth/callback
BASE_URL=http://localhost:8000

# Google Cloud -> Google Auth Platform -> İstemciler (Web uygulaması)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kanal anahtarlarını şifreleyen anahtar. Üretmek için:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Sunucuda MUTLAKA doldur ve sakla: kaybolursa kayıtlı kanallar yeniden bağlanmalı.
SECRET_KEY=
