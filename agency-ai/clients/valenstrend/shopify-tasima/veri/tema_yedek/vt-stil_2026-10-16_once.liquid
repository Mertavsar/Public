<style>
  /* Rozetler (görsel üstü) */
  .product-badges .product-badges__badge{font-size:11px;font-weight:700;letter-spacing:.08em;line-height:1;padding:7px 10px;text-transform:uppercase;border-radius:2px}
  .product-badges .product-badges__badge.color-custom-badge-sale{background:#9C5B3F;color:#fff}
  .product-badges .product-badges__badge.color-custom-badge-sold-out{background:rgba(255,255,255,.94);color:#6F6660;box-shadow:0 0 0 1px rgba(0,0,0,.08)}

  /* Fiyat: indirimli fiyat vurgulu, eski fiyat okunur gri + üstü çizili */
  .price-item__group.price{color:#9C5B3F;font-weight:700}
  .price,.price-item__group.price{letter-spacing:0}
  .compare-at-price.compare-at-price{font-size:.82em;font-weight:500;color:#6F6660;text-decoration-line:line-through;text-decoration-thickness:1.5px;text-decoration-color:rgba(111,102,96,.85);margin-inline-start:8px}

  /* Ürün kartı: ürün adı */
  product-card .product-card__content a[ref="productTitleLink"] .text-block,
  product-card .product-card__content a[ref="productTitleLink"] .text-block > *{font-family:var(--font-body--family);font-size:16px;line-height:1.35;font-weight:400;letter-spacing:0;text-transform:none;color:#2B2420}
  product-card .product-card__content a[ref="productTitleLink"] .text-block > *{margin:0;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}

  /* Ürün kartı: fiyat satırı */
  product-card .product-card__content product-price.text-block{font-family:var(--font-body--family);font-size:18px;line-height:1.25;font-weight:700;letter-spacing:0;text-transform:none;margin-top:2px}
  product-card .product-card__content product-price [ref="priceContainer"]{display:flex;flex-wrap:wrap;align-items:baseline;column-gap:10px;row-gap:2px}
  product-card .product-card__content product-price.text-center [ref="priceContainer"]{justify-content:center}
  product-card .product-card__content product-price .price{color:#2B2420;font-weight:700}
  product-card .product-card__content product-price .price-item__group.price{color:#9C5B3F}
  product-card .product-card__content product-price .compare-at-price{font-size:15px;margin:0}



  /* Ürün kartı: Sepete Ekle butonu (ince, zarif) */
  .vt-sepet{position:relative;z-index:3;width:100%;margin-top:auto;padding-top:4px}
  .vt-sepet product-form-component,.vt-sepet form,.vt-sepet add-to-cart-component{display:block;width:100%}
  .vt-sepet .button.vt-sepet__btn{position:relative;display:flex;align-items:center;justify-content:center;width:100%;min-width:0;height:34px;min-height:34px;padding:0 10px;margin:0;background:transparent;color:#2B2420;border:1px solid #D8D1CB;border-radius:2px;box-shadow:none;font-family:var(--font-body--family);font-size:11px;font-weight:500;line-height:1;letter-spacing:.12em;text-transform:uppercase;text-decoration:none;transition:background-color .2s ease,color .2s ease,border-color .2s ease}
  .vt-sepet .button.vt-sepet__btn::before,.vt-sepet .button.vt-sepet__btn::after{display:none}
  .vt-sepet .button.vt-sepet__btn:hover:not([disabled]){background:#2B2420;border-color:#2B2420;color:#fff}
  .vt-sepet .button.vt-sepet__btn[disabled]{background:transparent;color:#A39A94;border-color:#ECE7E3;cursor:not-allowed;opacity:1}

  /* Ürün sayfası: görsel sayfa genişliğinde ve sınırlı boyutta */
  @media (min-width:750px){
    .product-information__grid--half.product-information--media-left .product-information__media{min-width:0;width:100%;max-width:520px;justify-self:end}
    .product-information__grid--half.product-information--media-right .product-information__media{min-width:0;width:100%;max-width:520px;justify-self:start}
  }
  .product-details product-price [ref="priceContainer"]{display:flex;flex-wrap:wrap;align-items:center;row-gap:6px}
  .product-details product-price .price{font-weight:700}
  .product-details product-price .unit-price{flex-basis:100%}
  .product-details product-price .tax-note{margin-top:4px;font-size:12px;letter-spacing:.02em;text-transform:none}
  .product-details .text-block.rte p{color:#5E5650}


  /* Sepet: kargo ve hediye ilerlemesi (tek kutu) */
  .vt-kampanya{display:grid;gap:12px;margin:0 var(--cart-drawer-padding,0) 16px;padding:14px 16px;background:#F8F4EF;border:1px solid #EFE6DC;border-radius:10px;font-family:var(--font-body--family);color:#3A322D}
  .cart-page__title .vt-kampanya{margin:16px 0 0}
  .vt-kampanya__satir{display:grid;gap:7px}
  .vt-kampanya__ust{display:flex;align-items:center;gap:9px}
  .vt-kampanya__ikon{flex:none;width:18px;height:18px;color:#9C5B3F}
  .vt-kampanya__metin{flex:1;min-width:0;margin:0;font-size:13px;font-weight:400;line-height:1.35;letter-spacing:0;text-transform:none}
  .vt-kampanya__metin strong{font-weight:600;color:#2B2420}
  .vt-kampanya__metin a{color:#9C5B3F;font-weight:600;text-decoration:underline;text-underline-offset:2px}
  .vt-kampanya__sayac{flex:none;font-size:12px;font-weight:600;color:#9C5B3F;font-variant-numeric:tabular-nums}
  .vt-kampanya__bar{position:relative;height:4px;margin-inline-start:27px;background:#E8DED3;border-radius:99px;overflow:hidden}
  .vt-kampanya__bar span{position:absolute;inset:0 auto 0 0;max-width:100%;background:#9C5B3F;border-radius:99px;transition:width .4s ease}
  .vt-kampanya__satir--tamam .vt-kampanya__ikon,.vt-kampanya__satir--tamam .vt-kampanya__sayac{color:#4E7352}
  .vt-kampanya__satir--tamam .vt-kampanya__bar span{background:#4E7352}

  /* Sepet ürün satırları */
  .cart-items__table .cart-items__title{font-size:15px;line-height:1.35;color:#2B2420}
  .cart-items__table .cart-items__unit-price-wrapper{font-size:13px;color:#5E5650}
  .cart-items__table .cart-items__price{font-size:15px;font-weight:600;color:#2B2420}
  .cart-items__table .cart-items__details ul.list-unstyled li{font-size:12px;font-weight:600;color:#9C5B3F}

  /* Ürün sayfası: vergi notu sade */
  .product-details product-price .tax-note.tax-note.tax-note{font-size:13px;color:#6F6660;text-transform:none;letter-spacing:0}

  @media (max-width:749px){
    product-card .product-card__content a[ref="productTitleLink"] .text-block,
    product-card .product-card__content a[ref="productTitleLink"] .text-block > *{font-size:14px}
    product-card .product-card__content product-price.text-block{font-size:16px}
    product-card .product-card__content product-price .compare-at-price{font-size:13px}
    product-card .product-card__content product-price [ref="priceContainer"]{column-gap:7px}
    .product-details product-price.text-block{font-size:22px}
    .product-details .text-block h1{font-size:26px !important}
    .vt-sepet .button.vt-sepet__btn{height:32px;min-height:32px;font-size:10px;letter-spacing:.1em}
    .product-information .product-details{padding-top:22px}
    /* Mobil ürün görseli: kare oran, kenarlardan boşluklu */
    .product-information__media{padding:12px 16px 0}
    .product-information__media media-gallery{--gallery-aspect-ratio:1 !important}
    .product-information__media .product-media-container img{object-position:50% 30%}
  }
</style>
{% schema %}
{
  "name": "Site stilleri",
  "tag": "div",
  "class": "vt-stil",
  "settings": []
}
{% endschema %}
