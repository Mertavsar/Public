<div
  class="section section--page-width"
  style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;--vt-r1:{{ section.settings.ring_1 }};--vt-r2:{{ section.settings.ring_2 }};--vt-r3:{{ section.settings.ring_3 }};--vt-badge-bg:{{ section.settings.badge_bg }};--vt-badge-fg:{{ section.settings.badge_fg }};"
>
  <div class="vt-kat vt-kat--{{ section.settings.ring_style | default: 'classic' }}" id="vt-kat-{{ section.id }}">
    {%- if section.settings.heading != blank -%}
      <h2 class="vt-kat__title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="vt-kat__viewport">
      <button type="button" class="vt-kat__nav vt-kat__nav--prev" aria-label="Önceki kategoriler" disabled>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <div class="vt-kat__list">
        {%- if section.settings.show_bestsellers and section.settings.bestsellers_collection != blank -%}
          <a class="vt-kat__item vt-kat__item--star" href="{{ section.settings.bestsellers_collection.url }}">
            <span class="vt-kat__ring">
              <span class="vt-kat__gap">
                <span class="vt-kat__img vt-kat__img--icon">
                  <svg viewBox="0 0 24 24" width="38%" height="38%" fill="currentColor" aria-hidden="true"><path d="M12 2.6l2.83 5.94 6.53.79-4.8 4.5 1.23 6.47L12 17.13 6.21 20.3l1.23-6.47-4.8-4.5 6.53-.79z"/></svg>
                </span>
              </span>
            </span>
            <span class="vt-kat__name">{{ section.settings.bestsellers_label }}</span>
          </a>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- assign c = block.settings.collection -%}
          {%- if c == blank -%}{%- continue -%}{%- endif -%}
          {%- assign img = block.settings.image | default: c.featured_image -%}
          {%- assign label = block.settings.label | default: c.title -%}
          <a class="vt-kat__item" href="{{ c.url }}" {{ block.shopify_attributes }}>
            <span class="vt-kat__ring">
              <span class="vt-kat__gap">
                <span class="vt-kat__img">
                  {%- if img != blank -%}
                    {{ img | image_url: width: 320 | image_tag: loading: 'lazy', alt: label, widths: '160, 240, 320', sizes: '(max-width: 749px) 80px, 120px' }}
                  {%- endif -%}
                </span>
              </span>
              {%- if block.settings.badge != blank -%}
                <span class="vt-kat__badge">{{ block.settings.badge }}</span>
              {%- endif -%}
            </span>
            <span class="vt-kat__name">{{ label }}</span>
          </a>
        {%- endfor -%}

        {%- if section.settings.show_all -%}
          <a class="vt-kat__item vt-kat__item--all" href="{{ routes.all_products_collection_url }}">
            <span class="vt-kat__ring">
              <span class="vt-kat__gap">
                <span class="vt-kat__img vt-kat__img--icon">
                  <svg viewBox="0 0 24 24" width="34%" height="34%" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="12" x2="20" y2="12"/><polyline points="13 5 20 12 13 19"/></svg>
                </span>
              </span>
            </span>
            <span class="vt-kat__name">{{ section.settings.all_label }}</span>
          </a>
        {%- endif -%}
      </div>
      <button type="button" class="vt-kat__nav vt-kat__nav--next" aria-label="Sonraki kategoriler">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>
  </div>
  <style>
    #vt-kat-{{ section.id }} { --vt-size: 120px; --vt-gap: 22px; }
    #vt-kat-{{ section.id }} *, #vt-kat-{{ section.id }} *::before, #vt-kat-{{ section.id }} *::after { box-sizing: border-box; }
    .vt-kat__title { font-family: var(--font-heading--family); font-weight: 400; font-size: clamp(24px, 2.4vw, 32px); line-height: 1.2; text-align: center; margin: 0 0 24px; }
    .vt-kat__viewport { position: relative; }
    .vt-kat__list { display: flex; gap: var(--vt-gap); overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; -webkit-overflow-scrolling: touch; scrollbar-width: none; padding: 6px 4px 10px; scroll-padding-inline: 4px; }
    .vt-kat__list::-webkit-scrollbar { display: none; }
    .vt-kat--fits .vt-kat__list { justify-content: center; }
    .vt-kat__item { flex: 0 0 var(--vt-size); display: flex; flex-direction: column; align-items: center; gap: 12px; color: inherit; text-decoration: none; scroll-snap-align: start; -webkit-tap-highlight-color: transparent; }
    .vt-kat__item:focus-visible { outline: none; }
    .vt-kat__item:focus-visible .vt-kat__ring { box-shadow: 0 0 0 3px #fff, 0 0 0 5px #000; }

    .vt-kat__ring { position: relative; display: block; width: var(--vt-size); height: var(--vt-size); padding: 3px; border-radius: 50%; isolation: isolate; transition: transform .35s ease; }
    .vt-kat__ring::before { content: ""; position: absolute; inset: 0; z-index: -1; border-radius: 50%; background: conic-gradient(from 200deg, var(--vt-r1), var(--vt-r2), var(--vt-r3), var(--vt-r1)); transition: transform .9s ease; }
    .vt-kat__gap { display: block; width: 100%; height: 100%; padding: 3px; border-radius: 50%; background: #fff; }
    .vt-kat__img { display: block; width: 100%; height: 100%; border-radius: 50%; overflow: hidden; background: #f2f2f2; }
    .vt-kat__img img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center 25%; transition: transform .6s ease; }
    .vt-kat__img--icon { display: flex; align-items: center; justify-content: center; }

    .vt-kat__item:hover .vt-kat__ring { transform: translateY(-3px); }
    .vt-kat__item:hover .vt-kat__ring::before { transform: rotate(180deg); }
    .vt-kat__item:hover .vt-kat__img img { transform: scale(1.08); }

    .vt-kat__item--star .vt-kat__img { background: #000; color: #fff; }
    .vt-kat__item--star .vt-kat__ring::before { animation: vt-kat-spin 6s linear infinite; }
    .vt-kat__item--all .vt-kat__ring::before { background: #d9d9d9; }
    .vt-kat__item--all .vt-kat__img { background: #f2f2f2; color: #000; }
    .vt-kat__item--all:hover .vt-kat__img { background: #000; color: #fff; }

    .vt-kat__badge { position: absolute; left: 50%; bottom: -7px; transform: translateX(-50%); padding: 3px 9px; border-radius: 999px; background: var(--vt-badge-bg); color: var(--vt-badge-fg); box-shadow: 0 0 0 2px #fff; font-size: 10px; font-weight: 600; line-height: 1.2; letter-spacing: .06em; text-transform: uppercase; white-space: nowrap; }

    .vt-kat__name { min-height: 2.6em; max-width: calc(var(--vt-size) + 12px); font-size: 12px; font-weight: 500; letter-spacing: .06em; line-height: 1.3; text-transform: uppercase; text-align: center; }

    .vt-kat__nav { position: absolute; top: calc(6px + var(--vt-size) / 2); transform: translateY(-50%); z-index: 2; width: 42px; height: 42px; padding: 0; border-radius: 50%; border: 1px solid rgba(0,0,0,.12); background: #fff; color: #000; box-shadow: 0 4px 14px rgba(0,0,0,.10); display: flex; align-items: center; justify-content: center; cursor: pointer; transition: opacity .2s, background .2s, color .2s; }
    .vt-kat__nav:hover { background: #000; color: #fff; }
    .vt-kat__nav--prev { left: -12px; }
    .vt-kat__nav--next { right: -12px; }
    .vt-kat__nav:disabled { opacity: 0; pointer-events: none; }
    .vt-kat--fits .vt-kat__nav { display: none; }

    .vt-kat--classic .vt-kat__ring { padding: 1px; }
    .vt-kat--classic .vt-kat__ring::before { background: rgba(0,0,0,.12); transition: background .25s; }
    .vt-kat--classic .vt-kat__item:hover .vt-kat__ring { transform: none; }
    .vt-kat--classic .vt-kat__item:hover .vt-kat__ring::before { transform: none; background: #000; }
    .vt-kat--classic .vt-kat__item:hover .vt-kat__img img { transform: scale(1.05); }
    .vt-kat--classic .vt-kat__name { font-weight: 400; letter-spacing: .05em; }

    @keyframes vt-kat-spin { to { transform: rotate(360deg); } }
    @media (prefers-reduced-motion: reduce) {
      .vt-kat__ring, .vt-kat__ring::before, .vt-kat__img img { transition: none; }
      .vt-kat__item--star .vt-kat__ring::before { animation: none; }
    }

    @media (max-width: 749px) {
      #vt-kat-{{ section.id }} { --vt-size: 78px; --vt-gap: 14px; }
      .vt-kat__title { margin-bottom: 16px; }
      .vt-kat__list { padding: 4px 2px 8px; }
      .vt-kat__item { gap: 12px; }
      .vt-kat__ring { padding: 2px; }
      .vt-kat__gap { padding: 2px; }
      .vt-kat__badge { bottom: -6px; padding: 2px 6px; font-size: 8px; letter-spacing: .02em; }
      .vt-kat__name { font-size: 10px; letter-spacing: .03em; }
      .vt-kat__nav { display: none; }
      .vt-kat--classic .vt-kat__ring { padding: 1px; }
      .vt-kat--classic .vt-kat__name { letter-spacing: .03em; }
      .vt-kat:not(.vt-kat--fits):not(.vt-kat--end) .vt-kat__list { -webkit-mask-image: linear-gradient(90deg, #000 82%, transparent); mask-image: linear-gradient(90deg, #000 82%, transparent); }
    }
  </style>
  <script>
    (function () {
      var root = document.getElementById('vt-kat-{{ section.id }}');
      if (!root) return;
      var list = root.querySelector('.vt-kat__list');
      var prev = root.querySelector('.vt-kat__nav--prev');
      var next = root.querySelector('.vt-kat__nav--next');
      function step() {
        var item = list.querySelector('.vt-kat__item');
        var gap = parseFloat(getComputedStyle(list).columnGap) || 0;
        return item ? (item.getBoundingClientRect().width + gap) * 3 : 300;
      }
      function update() {
        var max = list.scrollWidth - list.clientWidth;
        root.classList.toggle('vt-kat--fits', max <= 2);
        root.classList.toggle('vt-kat--end', list.scrollLeft >= max - 8);
        prev.disabled = list.scrollLeft <= 8;
        next.disabled = list.scrollLeft >= max - 8;
      }
      prev.addEventListener('click', function () { list.scrollBy({ left: -step(), behavior: 'smooth' }); });
      next.addEventListener('click', function () { list.scrollBy({ left: step(), behavior: 'smooth' }); });
      list.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    })();
  </script>
</div>

{% schema %}
{
  "name": "Kategori ikonları",
  "tag": "section",
  "class": "vt-kat-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Başlık",
      "default": "Kategoriler"
    },
    {
      "type": "header",
      "content": "Çok Satanlar balonu"
    },
    {
      "type": "checkbox",
      "id": "show_bestsellers",
      "label": "Başta Çok Satanlar balonunu göster",
      "default": true
    },
    {
      "type": "collection",
      "id": "bestsellers_collection",
      "label": "Çok Satanlar koleksiyonu"
    },
    {
      "type": "text",
      "id": "bestsellers_label",
      "label": "Çok Satanlar yazısı",
      "default": "Çok Satanlar"
    },
    {
      "type": "header",
      "content": "Tümünü Gör balonu"
    },
    {
      "type": "checkbox",
      "id": "show_all",
      "label": "Sonda Tümünü Gör balonunu göster",
      "default": true
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "Tümünü Gör yazısı",
      "default": "Tümünü Gör"
    },
    {
      "type": "header",
      "content": "Görünüm"
    },
    {
      "type": "select",
      "id": "ring_style",
      "label": "Çerçeve stili",
      "options": [
        { "value": "classic", "label": "Klasik (ince çerçeve)" },
        { "value": "color", "label": "Renkli halka" }
      ],
      "default": "classic"
    },
    {
      "type": "color",
      "id": "ring_1",
      "label": "Halka rengi 1",
      "default": "#F5A623"
    },
    {
      "type": "color",
      "id": "ring_2",
      "label": "Halka rengi 2",
      "default": "#E4405F"
    },
    {
      "type": "color",
      "id": "ring_3",
      "label": "Halka rengi 3",
      "default": "#833AB4"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Rozet arka planı",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "badge_fg",
      "label": "Rozet yazısı",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Boşluklar"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Üst boşluk",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Alt boşluk",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "kategori",
      "name": "Kategori",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Koleksiyon"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Görsel",
          "info": "Boş bırakılırsa koleksiyonun görseli kullanılır."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Yazı",
          "info": "Boş bırakılırsa koleksiyonun adı yazılır."
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Rozet",
          "info": "Örn. Çok Satan, Yeni, Kampanya. Boş bırakılırsa rozet çıkmaz."
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Kategori ikonları"
    }
  ]
}
{% endschema %}
